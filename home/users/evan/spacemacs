  (defun el2-format-buffer ()
    "Format current buffer using `el2-format'."
    (interactive)
    (let ((cmd (el2--formatter-command)))
      (unless cmd
        (user-error "Could not find el2-format (or dune project root)"))
      (let ((errbuf (get-buffer-create "*el2-format*"))
            (outbuf (generate-new-buffer " *el2-format-out*"))
            (errfile (make-temp-file "el2-format-stderr-"))
            (source (buffer-substring-no-properties (point-min) (point-max)))
            (orig-point (point))
            (orig-window-start (window-start)))
        (with-current-buffer errbuf
          (erase-buffer))
        (unwind-protect
            (let ((status
                   (with-temp-buffer
                     (insert source)
                     (apply #'call-process-region
                            (point-min) (point-max)
                            (car cmd)
                            nil
                            (list outbuf errfile)
                            nil
                            (cdr cmd)))))
              (with-current-buffer errbuf
                (insert-file-contents errfile))
              (if (zerop status)
                  (progn
                    (erase-buffer)
                    (insert-buffer-substring-no-properties outbuf)
                    (goto-char (min orig-point (point-max)))
                    (set-window-start (selected-window) orig-window-start)
                    t)
                (message "el2-format failed; see *el2-format* buffer")
                nil))
          (ignore-errors (delete-file errfile))
          (kill-buffer outbuf)))))

